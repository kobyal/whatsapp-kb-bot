[Unit]
Description=WhatsApp KB bot - listener (Baileys)
After=network-online.target
Wants=network-online.target

[Service]
User=wakb
WorkingDirectory=/opt/wakb/src/listener
EnvironmentFile=/etc/wakb.env
ExecStart=/usr/bin/node listener.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
